# Copy to .env next to compose.yaml, then: docker compose up -d --build
# The name or IP address visitors type into the browser: demo.example.com, or 192.168.1.20 on your LAN.
DEMO_HOST=localhost
# Host ports nginx listens on. Keep 80/443 for a public server (Let's Encrypt needs 80).
HTTP_PORT=80
HTTPS_PORT=443
# Reports older than this many days are deleted. 0 keeps everything.
DEMO_RETENTION_DAYS=90
