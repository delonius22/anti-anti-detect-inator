# Copy to /etc/capture-app.env (chmod 600). Generate the token with: openssl rand -hex 32
ADMIN_TOKEN=change-me
PUBLIC_ORIGIN=https://m.example.com
ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be
DB_PATH=/var/lib/capture-app/visits.db
PORT=3000
# Placeholder until C1/C2 cohort runs give you a real threshold:
RTT_GAP_MS=50
# WebRTC public-IP check (J11). Leave empty to disable the third-party STUN request.
STUN_URL=stun:stun.l.google.com:19302
# IP databases (deploy/update-geoip.sh) and bot IP lists (scripts/update-bot-ips.js)
GEOIP_DIR=/var/lib/capture-app/geoip
BOT_IPS_FILE=/var/lib/capture-app/bot-ips.json
# Server location for the speed-of-light check (H5). Either set coordinates...
#SERVER_LAT=50.11
#SERVER_LON=8.68
# ...or the server's public IP, looked up in the IP databases at startup:
SERVER_PUBLIC_IP=
# System 1 model (optional): per-visit human/agent/anti-detect percentages.
# model.json comes from: python -m inator_analysis report --db visits.db --out phase6
#MODEL_FILE=/var/lib/capture-app/model.json
# Expected real-world mix; without it, percentages reflect your test-run mix:
#MODEL_PRIORS=human=0.97,agent=0.02,antidetect=0.01
